# LumaLoop web — local environment variables (accounts pivot).
#
# Copy this file to `.env.local` (gitignored) and fill in the real values for
# local development. Vite only exposes vars prefixed with `VITE_` to client code
# (import.meta.env). These two are the Supabase project URL + the PUBLISHABLE
# (anon) key — both are safe to ship in the client bundle; RLS is the security
# boundary (see supabase/migrations/0002_profiles_game_plays.sql). NEVER put a
# service-role / secret key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key_here
